import pygame
import time
import random
import sys  # Adicione esse import

pygame.init()

# Cores
branco = (255, 255, 255)
preto = (0, 0, 0)
vermelho = (213, 50, 80)
verde = (0, 255, 0)
azul = (50, 153, 213)

largura = 600
altura = 400
tamanho_bloco = 10
velocidade = 15

fonte = pygame.font.SysFont("bahnschrift", 25)

tela = pygame.display.set_mode((largura, altura))
pygame.display.set_caption('Jogo da Cobrinha')
clock = pygame.time.Clock()

def mostrar_pontuacao(pontos):
    valor = fonte.render("Pontuação: " + str(pontos), True, azul)
    tela.blit(valor, [0, 0])

def desenhar_cobrinha(tamanho_bloco, lista_cobra):
    for bloco in lista_cobra:
        pygame.draw.rect(tela, verde, [bloco[0], bloco[1], tamanho_bloco, tamanho_bloco])

def gameLoop():
    x = largura / 2
    y = altura / 2
    x_velocidade = 0
    y_velocidade = 0
    corpo_cobra = []
    comprimento_cobra = 1
    comida_x = round(random.randrange(0, largura - tamanho_bloco) / 10.0) * 10.0
    comida_y = round(random.randrange(0, altura - tamanho_bloco) / 10.0) * 10.0

    fim_jogo = False
    fim_jogo_perdeu = False

    while not fim_jogo:
        while fim_jogo_perdeu:
            tela.fill(preto)
            mensagem = fonte.render('Você perdeu! Pressione C para continuar ou Q para sair', True, vermelho)
            tela.blit(mensagem, [largura / 6, altura / 3])
            mostrar_pontuacao(comprimento_cobra - 1)
            pygame.display.update()
            for evento in pygame.event.get():
                if evento.type == pygame.QUIT:
                    pygame.quit()
                    sys.exit()
                if evento.type == pygame.KEYDOWN:
                    if evento.key == pygame.K_q:
                        pygame.quit()
                        sys.exit()
                    if evento.key == pygame.K_c:
                        gameLoop()
                        return  # Garante que não continue o loop antigo

        for evento in pygame.event.get():
            if evento.type == pygame.QUIT:
                pygame.quit()
                sys.exit()
            if evento.type == pygame.KEYDOWN:
                if evento.key == pygame.K_LEFT and x_velocidade == 0:
                    x_velocidade = -tamanho_bloco
                    y_velocidade = 0
                elif evento.key == pygame.K_RIGHT and x_velocidade == 0:
                    x_velocidade = tamanho_bloco
                    y_velocidade = 0
                elif evento.key == pygame.K_UP and y_velocidade == 0:
                    y_velocidade = -tamanho_bloco
                    x_velocidade = 0
                elif evento.key == pygame.K_DOWN and y_velocidade == 0:
                    y_velocidade = tamanho_bloco
                    x_velocidade = 0

        x += x_velocidade
        y += y_velocidade

        # Checa se a cobra bateu na parede
        if x >= largura or x < 0 or y >= altura or y < 0:
            fim_jogo_perdeu = True

        tela.fill(preto)
        pygame.draw.rect(tela, vermelho, [comida_x, comida_y, tamanho_bloco, tamanho_bloco])

        cabeca_cobra = [x, y]
        corpo_cobra.append(cabeca_cobra)
        if len(corpo_cobra) > comprimento_cobra:
            del corpo_cobra[0]

        # Checa colisão com o próprio corpo
        for bloco in corpo_cobra[:-1]:
            if bloco == cabeca_cobra:
                fim_jogo_perdeu = True

        desenhar_cobrinha(tamanho_bloco, corpo_cobra)
        mostrar_pontuacao(comprimento_cobra - 1)
        pygame.display.update()

        # Cobra come a comida
        if x == comida_x and y == comida_y:
            comida_x = round(random.randrange(0, largura - tamanho_bloco) / 10.0) * 10.0
            comida_y = round(random.randrange(0, altura - tamanho_bloco) / 10.0) * 10.0
            comprimento_cobra += 1

        clock.tick(velocidade)

    pygame.quit()
    sys.exit()

gameLoop()
